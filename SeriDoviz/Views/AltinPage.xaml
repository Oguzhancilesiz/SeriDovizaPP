<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeriDoviz.Views.AltinPage"
             BackgroundColor="{StaticResource Bg}">
    <Grid RowDefinitions="170,Auto,*" RowSpacing="0">

        <Grid Grid.Row="0" Background="{StaticResource HeaderBrush}">
            <Grid Padding="16,18" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <ImageButton Style="{StaticResource SearchFab}"
                                 Source="ic_search_gold.png"
                                 BackgroundColor="{StaticResource CardAlt}"
                                 Command="{Binding SearchCommand}" />
                    <Label Grid.Column="1" Text="Altın piyasası"
                           TextColor="{StaticResource Gold}" FontAttributes="Bold"
                           VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                    <ImageButton Grid.Column="2" Source="ic_refresh_gold.png"
                                 BackgroundColor="Transparent"
                                 Command="{Binding RefreshCommand}" />
                </Grid>

                <CollectionView x:Name="HeaderTicker"
                                Grid.Row="1"
                                ItemsSource="{Binding HeaderItems}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="92"
                                BackgroundColor="Transparent"
                                SelectionMode="None"
                                HorizontalScrollBarVisibility="Never"
                                Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MiniCard}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding Symbol}" TextColor="{StaticResource Gold}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Ask, StringFormat='{}{0:N2}'}"
                                           FontSize="22" HorizontalTextAlignment="End"/>
                                    <Label Grid.Row="1" Text="{Binding Bid, StringFormat='Alış {0:N2}'}" Style="{StaticResource MutedLabel}" />
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Pill}"
                                            Background="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}, ConverterParameter=bg}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding TickArrow}"
                                                   TextColor="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}}"/>
                                            <Label Text="{Binding Change, StringFormat='{}{0:0.00}%'}"
                                                   TextColor="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Padding="16,10" ColumnDefinitions="2*,*,*"
              BackgroundColor="{StaticResource CardAlt}">
            <Label Text="Ürün" />
            <Label Text="Alış" Grid.Column="1" HorizontalTextAlignment="End"/>
            <Label Text="Satış" Grid.Column="2" HorizontalTextAlignment="End"/>
        </Grid>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}"
                     BackgroundColor="Transparent">
            <CollectionView ItemsSource="{Binding Items}" BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}"
                                Background="{Binding Flash, TargetNullValue={StaticResource CardBrush}}">
                            <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Symbol}" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{Binding Bid, StringFormat='{}{0:N2}'}" HorizontalTextAlignment="End"/>
                                <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Ask, StringFormat='{}{0:N2}'}" HorizontalTextAlignment="End" />
                                    <Border Grid.Column="1" Style="{StaticResource Pill}"
                                            Background="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}, ConverterParameter=bg}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding TickArrow}"
                                                   TextColor="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}}"/>
                                            <Label Text="{Binding Change, StringFormat='{}{0:0.00}%'}"
                                                   TextColor="{Binding TickDir, Converter={StaticResource ChangeToColorConverter}}"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Grid IsVisible="{Binding OverlayVisible}" InputTransparent="False" BackgroundColor="#AA000000">
            <Grid VerticalOptions="Center" HorizontalOptions="Center">
                <Border Background="{StaticResource Card}" StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 12">
                    <HorizontalStackLayout Spacing="12" Padding="4">
                        <ActivityIndicator IsRunning="True" Color="{StaticResource Gold}"/>
                        <Label Text="Veriler alınıyor... Güncel kurlar çekiliyor" TextColor="{StaticResource Text}"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>
